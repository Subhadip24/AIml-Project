        "# --- Bias-Variance Trade-off Visualization ---\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "error_train = [1 - s for s in train_scores]\n",
        "error_test = [1 - s for s in test_scores]\n",
        "ax.plot(k_range, error_train, 'o-', label='Train Error (~ Bias^2)', color='#e74c3c', linewidth=2)\n",
        "ax.plot(k_range, error_test, 's-', label='Test Error (Bias^2 + Variance)', color='#3498db', linewidth=2)\n",
