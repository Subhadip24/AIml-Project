            "\n"
          ]
        }
      ],
      "source": [
        "param_grid = {\n",
        "    'n_neighbors': list(range(1, 26)),\n",
        "    'weights': ['uniform', 'distance'],\n",
        "    'metric': ['euclidean', 'manhattan', 'minkowski'],\n",
        "    'p': [1, 2, 3],\n",
        "}\n",
        "\n",
        "grid_search = GridSearchCV(\n",
        "    KNeighborsClassifier(),\n",
        "    param_grid,\n",
        "    cv=StratifiedKFold(n_splits=10, shuffle=True, random_state=42),\n",
        "    scoring='accuracy',\n",
        "    n_jobs=-1,\n",
        "    verbose=1,\n",
        ")\n",
        "grid_search.fit(X_train_scaled, y_train)\n",
        "\n",
        "best_params = grid_search.best_params_\n",
        "best_grid_acc = grid_search.best_score_\n",
        "print(f'\\nBest Parameters: {best_params}')\n",
        "print(f'Best CV Accuracy: {best_grid_acc:.4f} ({best_grid_acc*100:.2f}%)')\n",
        "\n",
        "# Evaluate best model on test set\n",
        "best_knn = grid_search.best_estimator_\n",
        "y_pred_best = best_knn.predict(X_test_scaled)\n",
        "best_test_acc = accuracy_score(y_test, y_pred_best)\n",
        "\n",
        "print(f'Test Accuracy  : {best_test_acc:.4f} ({best_test_acc*100:.2f}%)')\n",
        "print(f'\\nClassification Report (Best Model):')\n",
        "print(classification_report(y_test, y_pred_best, target_names=['No Disease', 'Disease']))"
      ]
    },
