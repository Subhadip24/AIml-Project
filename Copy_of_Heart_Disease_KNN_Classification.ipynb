        "# Panel 1: Train vs Test\n",
        "axes[0].plot(k_range, train_scores, 'o-', label='Train Accuracy', color='#e74c3c', linewidth=2)\n",
        "axes[0].plot(k_range, test_scores, 's-', label='Test Accuracy', color='#2ecc71', linewidth=2)\n",
        "axes[0].axvline(x=best_k_cv, color='gray', linestyle='--', alpha=0.7, label=f'Best K = {best_k_cv}')\n",
