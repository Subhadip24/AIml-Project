            "weighted avg       0.81      0.80      0.80        61\n",
            "\n"
          ]
        }
      ],
      "source": [
        "print(f'Before SMOTE: {dict(zip(*np.unique(y_train, return_counts=True)))}')\n",
        "\n",
        "smote = SMOTE(random_state=42)\n",
        "X_train_smote, y_train_smote = smote.fit_resample(X_train_scaled, y_train)\n",
        "\n",
        "print(f'After  SMOTE: {dict(zip(*np.unique(y_train_smote, return_counts=True)))}')\n",
        "print(f'Augmented training set size: {X_train_smote.shape[0]} samples')\n",
        "\n",
        "# Train with SMOTE-augmented data\n",
        "knn_smote = KNeighborsClassifier(n_neighbors=best_k_cv)\n",
        "knn_smote.fit(X_train_smote, y_train_smote)\n",
        "y_pred_smote = knn_smote.predict(X_test_scaled)\n",
        "smote_acc = accuracy_score(y_test, y_pred_smote)\n",
        "\n",
        "print(f'\\nAccuracy with SMOTE (K={best_k_cv}): {smote_acc:.4f} ({smote_acc*100:.2f}%)')\n",
        "print(f'Baseline Accuracy (K={best_k_cv}):   {test_scores[best_k_cv-1]:.4f}')\n",
        "print(f'\\nClassification Report (SMOTE):')\n",
        "print(classification_report(y_test, y_pred_smote, target_names=['No Disease', 'Disease']))"
      ]
    },
