        "ax.axvline(x=best_k_cv, color='gray', linestyle='--', alpha=0.7, label=f'Best K = {best_k_cv}')\n",
        "ax.set_xlabel('K (Number of Neighbors)')\n",
        "ax.set_ylabel('Error Rate')\n",
        "ax.set_title('Bias-Variance Trade-off in KNN', fontweight='bold', fontsize=13)\n",
        "ax.legend()\n",
        "ax.set_xticks(range(1, 31, 2))\n",
        "ax.annotate('<-- Low K: High Variance\\n   (Overfitting)', xy=(2, error_test[1]),\n",
        "            fontsize=9, color='#e74c3c', fontweight='bold')\n",
        "ax.annotate('High K: High Bias -->\\n(Underfitting)', xy=(24, error_test[23]),\n",
        "            fontsize=9, color='#3498db', fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.show()"
