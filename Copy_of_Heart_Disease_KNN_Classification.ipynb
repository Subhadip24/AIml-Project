        "    fmt='o-', color='#3498db', ecolor='#bdc3c7', capsize=3, linewidth=2,\n",
        "    label='10-fold CV Accuracy',\n",
        ")\n",
        "axes[1].axvline(x=best_k_cv, color='gray', linestyle='--', alpha=0.7, label=f'Best K = {best_k_cv}')\n",
        "axes[1].set_xlabel('K (Number of Neighbors)')\n",
        "axes[1].set_ylabel('CV Accuracy')\n",
        "axes[1].set_title('10-Fold Cross-Validation Accuracy', fontweight='bold')\n",
        "axes[1].legend()\n",
        "axes[1].set_xticks(range(1, 31, 2))\n",
        "\n",
        "plt.tight_layout()\n",
